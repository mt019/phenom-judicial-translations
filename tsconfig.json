{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "noEmit": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "node_modules/@phenomcanvas/ui-vue/src/**/*.ts",
    "node_modules/@phenomcanvas/ui-vue/src/**/*.vue",
    "node_modules/@phenomcanvas/ui-vue/src/**/*.js",
    "node_modules/@phenomcanvas/ui-vue/core/**/*.js"
  ]
}
