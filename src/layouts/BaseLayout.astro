---
import '../styles/global.css';
interface Props {
  title: string;
  description: string;
  canonical: string;
  type?: string;
}
const { title, description, canonical, type = 'website' } = Astro.props;
const fullCanonical = new URL(canonical, 'https://foreignlaw.phenomcanvas.com').href;
const schema = {
  '@context': 'https://schema.org',
  '@type': type,
  name: title,
  description,
  url: fullCanonical,
  inLanguage: 'zh-Hant',
  isAccessibleForFree: true,
  publisher: { '@type': 'Organization', name: 'Phenom' },
};
---
<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <link rel="canonical" href={fullCanonical} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={fullCanonical} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要內容</a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="外國法中譯首頁">Phenom <span>Foreign Law</span></a>
      <nav aria-label="主要導覽">
        <a href="/">翻譯索引</a>
        <a href="/glossary/">德中譯語</a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer>
      <p>資料整理自司法院公開出版品。本站提供檢索與來源定位，不取代官方文本。</p>
      <p><a href="https://www.judicial.gov.tw/" rel="noreferrer">司法院官網</a> · <a href="/glossary/">德中法學譯語工作表</a></p>
    </footer>
  </body>
</html>
