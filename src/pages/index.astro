---
import BaseLayout from '../layouts/BaseLayout.astro';
import reportsData from '../data/generated/reports.json';
import assetManifest from '../data/generated/assets.json';
const reports = reportsData['報告'];
const summary = reportsData['摘要'];
const cases = reports.flatMap((report) =>
  report['檔案']
    .filter((file) => file['類型'] === '案件' && file['案名'])
    .map((file) => ({
      title: file['案名'],
      issue: file['爭點'] || '',
      translators: file['譯者'] || [],
      series: report['系列'] || report['分類'],
      volume: report['輯次'],
      year: (report['採信年月ISO'] || report['初版年月'] || '').slice(0, 4),
      pages: file['頁數'],
      bytes: file['位元組'],
      assetKey: file.assetKey,
    }))
);
const publicReports = reports.map((report) => ({
  name: report['報告名稱'],
  category: report['分類'],
  series: report['系列'],
  volume: report['輯次'],
  date: report['採信年月ISO'] || report['初版年月'],
  cases: report['案件數'],
  files: report['檔案數'],
  pages: report['頁數'],
  official: report['官方詳情頁'],
}));
const assetBase = import.meta.env.PUBLIC_ASSET_BASE || assetManifest.publicBase;
const description = `司法院外國法中譯公開索引：${summary['官方報告數']} 筆報告、${summary['案件總數']} 件裁判譯文，可依案名、譯者、系列與年代搜尋並閱讀 PDF。`;
---
<BaseLayout title="司法院外國法中譯索引｜Phenom" description={description} canonical="/" type="CollectionPage">
  <section class="hero">
    <p class="eyebrow">JUDICIAL YUAN · TRANSLATED FOREIGN LAW</p>
    <h1>半世紀的外國法中譯，<br />重新排成可尋路的索引。</h1>
    <p class="lede">從德國聯邦憲法法院、歐洲人權法院到美國、日本等法域。依案名、爭點、譯者或卷冊搜尋；PDF 保留官方出版脈絡，以獨立檔案開啟。</p>
    <dl class="metrics">
      <div><dt>官方報告</dt><dd>{summary['官方報告數']}</dd></div>
      <div><dt>裁判譯文</dt><dd>{summary['案件總數']}</dd></div>
      <div><dt>可辨識參與人</dt><dd>{summary['可辨識參與人']}</dd></div>
      <div><dt>時間範圍</dt><dd class="range">{summary['採信時間範圍']}</dd></div>
    </dl>
  </section>

  <section class="tool" data-search-root>
    <div class="tool-heading">
      <div>
        <p class="kicker">CASE FINDER</p>
        <h2>案件檢索</h2>
      </div>
      <a class="quiet-link" href="/glossary/">找德中法學譯語 →</a>
    </div>
    <div class="controls">
      <label class="search-field">
        <span>搜尋案名、爭點、譯者</span>
        <input id="case-search" type="search" inputmode="search" autocomplete="off" placeholder="例：被遺忘權、李念祖、選舉…" />
      </label>
      <label><span>系列</span><select id="series-filter"><option value="">全部系列</option></select></label>
      <label><span>年代</span><select id="decade-filter"><option value="">全部年代</option></select></label>
    </div>
    <p id="result-count" class="result-count" aria-live="polite"></p>
    <div id="case-results" class="result-list"></div>
    <button id="show-more" class="more-button" type="button" hidden>顯示更多</button>
  </section>

  <section class="volumes">
    <div class="section-heading">
      <p class="kicker">COLLECTIONS</p>
      <h2>卷冊與官方來源</h2>
      <p>46 筆報告仍按原系列與輯次保留；從案件檢索進入，是最快的讀法。</p>
    </div>
    <div class="volume-grid">
      {publicReports.map((report) => (
        <article>
          <p class="volume-meta">{report.category}{report.volume ? ` · 第 ${report.volume} 輯` : ''}</p>
          <h3>{report.name}</h3>
          <p>{report.date || '日期待考'} · {report.cases} 件案件 · {report.pages || '—'} 頁</p>
          {report.official && <a href={report.official} target="_blank" rel="noreferrer">官方詳情頁 ↗</a>}
        </article>
      ))}
    </div>
  </section>

  <dialog id="pdf-dialog" class="pdf-dialog">
    <div class="dialog-bar">
      <div><strong id="pdf-title"></strong><span id="pdf-meta"></span></div>
      <div><a id="pdf-open" target="_blank" rel="noreferrer">另開 PDF ↗</a><button id="pdf-close" type="button" aria-label="關閉 PDF">關閉</button></div>
    </div>
    <iframe id="pdf-frame" title="PDF 閱讀器"></iframe>
  </dialog>

  <script define:vars={{ cases, assetBase }}>
    const root = document.querySelector('[data-search-root]');
    const input = root.querySelector('#case-search');
    const series = root.querySelector('#series-filter');
    const decade = root.querySelector('#decade-filter');
    const output = root.querySelector('#case-results');
    const count = root.querySelector('#result-count');
    const more = root.querySelector('#show-more');
    const dialog = document.querySelector('#pdf-dialog');
    const normalize = (value) => String(value || '').normalize('NFKC').toLocaleLowerCase('zh-Hant');
    const formatBytes = (bytes) => bytes ? `${(bytes / 1024 / 1024).toFixed(1)} MB` : '';
    const values = (key) => [...new Set(cases.map((item) => item[key]).filter(Boolean))].sort();
    for (const name of values('series')) series.add(new Option(name, name));
    for (const name of [...new Set(cases.map((item) => item.year && `${item.year.slice(0, 3)}0s`).filter(Boolean))].sort())
      decade.add(new Option(name, name));
    let limit = 40;
    let current = [];
    const openPdf = (item) => {
      const url = `${assetBase.replace(/\/$/, '')}/${item.assetKey.split('/').map(encodeURIComponent).join('/')}`;
      document.querySelector('#pdf-title').textContent = item.title;
      document.querySelector('#pdf-meta').textContent = [item.series, item.translators.join('、') && `${item.translators.join('、')} 譯`, item.pages && `${item.pages} 頁`, formatBytes(item.bytes)].filter(Boolean).join(' · ');
      document.querySelector('#pdf-open').href = url;
      document.querySelector('#pdf-frame').src = url;
      dialog.showModal();
    };
    const render = () => {
      const needle = normalize(input.value.trim());
      current = cases.filter((item) => {
        const haystack = normalize([item.title, item.issue, item.translators.join(' '), item.series, item.year].join(' '));
        return (!needle || haystack.includes(needle))
          && (!series.value || item.series === series.value)
          && (!decade.value || `${item.year?.slice(0, 3)}0s` === decade.value);
      });
      count.textContent = `找到 ${current.length.toLocaleString('zh-TW')} 件裁判譯文`;
      output.replaceChildren(...current.slice(0, limit).map((item) => {
        const card = document.createElement('article');
        card.className = 'case-card';
        const heading = document.createElement('h3');
        heading.textContent = item.title;
        const meta = document.createElement('p');
        meta.className = 'case-meta';
        meta.textContent = [item.series, item.volume && `第 ${item.volume} 輯`, item.year, item.translators.length && `${item.translators.join('、')} 譯`].filter(Boolean).join(' · ');
        card.append(heading, meta);
        if (item.issue) {
          const issue = document.createElement('p');
          issue.className = 'case-issue';
          issue.textContent = item.issue;
          card.append(issue);
        }
        const button = document.createElement('button');
        button.type = 'button';
        button.textContent = '閱讀 PDF';
        button.addEventListener('click', () => openPdf(item));
        card.append(button);
        return card;
      }));
      more.hidden = current.length <= limit;
    };
    input.addEventListener('input', () => { limit = 40; render(); });
    series.addEventListener('change', () => { limit = 40; render(); });
    decade.addEventListener('change', () => { limit = 40; render(); });
    more.addEventListener('click', () => { limit += 40; render(); });
    document.querySelector('#pdf-close').addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => { document.querySelector('#pdf-frame').src = 'about:blank'; });
    render();
  </script>
</BaseLayout>
