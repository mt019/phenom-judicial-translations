---
import BaseLayout from '../layouts/BaseLayout.astro';
import data from '../data/generated/glossary.json';
const terms = data['術語'];
const summary = data['摘要'];
const rulings = data['裁決'];
const description = `德國聯邦憲法法院裁判選輯第 6–18 輯的德中法學關鍵詞工作表，共 ${summary['術語對數']} 組對照，保留多譯與裁決脈絡。`;
---
<BaseLayout title="德中法學譯語工作表｜Phenom" description={description} canonical="/glossary/" type="Dataset">
  <section class="hero glossary-hero">
    <p class="eyebrow">GERMAN–CHINESE LEGAL GLOSSARY</p>
    <h1>德中法學譯語，<br />連同分歧一起留下來。</h1>
    <p class="lede">來自《德國聯邦憲法法院裁判選輯》第 6–18 輯附錄。多譯詞經逐組裁決；其餘單一對照尚未逐條複核，因此這是一份可追溯的工作表，不是權威辭典。</p>
    <dl class="metrics">
      <div><dt>術語對</dt><dd>{summary['術語對數']}</dd></div>
      <div><dt>多譯德詞</dt><dd>{summary['多譯德詞數']}</dd></div>
      <div><dt>涵蓋卷次</dt><dd class="range">6–18</dd></div>
      <div><dt>有脈絡組數</dt><dd>{summary['脈絡覆蓋']['有脈絡組數']}</dd></div>
    </dl>
  </section>

  <section class="notice">
    <strong>使用範圍</strong>
    <p>{data['狀態說明']}</p>
  </section>

  <section class="tool" data-glossary-root>
    <div class="tool-heading">
      <div><p class="kicker">TERM FINDER</p><h2>譯語檢索</h2></div>
      <a class="quiet-link" href="/">回到裁判譯文 →</a>
    </div>
    <div class="controls">
      <label class="search-field"><span>搜尋德文或中文</span><input id="term-search" type="search" autocomplete="off" placeholder="例：Verhältnismäßigkeit、比例原則…" /></label>
      <label><span>類型</span><select id="type-filter"><option value="">全部類型</option></select></label>
      <label><span>狀態</span><select id="status-filter"><option value="">全部狀態</option></select></label>
    </div>
    <p id="term-count" class="result-count" aria-live="polite"></p>
    <div id="term-results" class="term-list"></div>
    <button id="term-more" class="more-button" type="button" hidden>顯示更多</button>
  </section>

  <section class="rulings">
    <div class="section-heading"><p class="kicker">TRANSLATION DECISIONS</p><h2>多譯裁決</h2><p>不是抹平差異；能定一詞者說明理由，必須依語境者保留並存。</p></div>
    <div class="ruling-grid">
      {rulings.map((ruling) => (
        <article>
          <h3 lang="de">{ruling.de}</h3>
          <p class="ruling-answer">{ruling['標準中譯']} · {ruling['類別說明']}</p>
          <p>{ruling['理由']}</p>
        </article>
      ))}
    </div>
  </section>

  <script define:vars={{ terms }}>
    const root = document.querySelector('[data-glossary-root]');
    const input = root.querySelector('#term-search');
    const type = root.querySelector('#type-filter');
    const status = root.querySelector('#status-filter');
    const output = root.querySelector('#term-results');
    const count = root.querySelector('#term-count');
    const more = root.querySelector('#term-more');
    const normalize = (value) => String(value || '').normalize('NFKC').toLocaleLowerCase('de');
    const unique = (key) => [...new Set(terms.flatMap((term) => Array.isArray(term[key]) ? term[key] : [term[key]]).filter(Boolean))].sort();
    for (const value of unique('類型')) type.add(new Option(value, value));
    for (const value of unique('狀態')) status.add(new Option(value, value));
    let limit = 60;
    let filtered = [];
    const render = () => {
      const needle = normalize(input.value.trim());
      filtered = terms.filter((term) => (!needle || normalize(`${term.de} ${term.zh}`).includes(needle))
        && (!type.value || term['類型'] === type.value)
        && (!status.value || term['狀態'] === status.value));
      count.textContent = `找到 ${filtered.length.toLocaleString('zh-TW')} 組德中對照`;
      output.replaceChildren(...filtered.slice(0, limit).map((term) => {
        const row = document.createElement('article');
        row.className = 'term-row';
        const de = document.createElement('h3');
        de.lang = 'de';
        de.textContent = term.de;
        const zh = document.createElement('p');
        zh.className = 'term-zh';
        zh.textContent = term.zh;
        const meta = document.createElement('p');
        meta.className = 'term-meta';
        meta.textContent = [term['類型'], term['狀態'], `第 ${term['卷次'].join('、')} 輯`].filter(Boolean).join(' · ');
        row.append(de, zh, meta);
        return row;
      }));
      more.hidden = filtered.length <= limit;
    };
    input.addEventListener('input', () => { limit = 60; render(); });
    type.addEventListener('change', () => { limit = 60; render(); });
    status.addEventListener('change', () => { limit = 60; render(); });
    more.addEventListener('click', () => { limit += 60; render(); });
    render();
  </script>
</BaseLayout>
