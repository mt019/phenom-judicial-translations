{
  "name": "phenom-judicial-translations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "data:local": "node scripts/export-local-data.mjs",
    "prebuild": "node scripts/prepare-build.mjs",
    "build": "npm run check:types && vite build && vite build --ssr src/entry-server.jsx --outDir .ssr && node scripts/render-static.mjs && node scripts/write-deployment-manifest.mjs && node scripts/validate-build.mjs",
    "dev": "node scripts/prepare-build.mjs && vite",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "check:types": "vue-tsc --noEmit"
  },
  "engines": {
    "node": ">=22.18 <23"
  },
  "dependencies": {
    "@phenomcanvas/ui-vue": "file:vendor/phenomcanvas-ui-vue-0.3.0.tgz",
    "@vue/server-renderer": "3.5.44",
    "katex": "0.17.0",
    "lucide-vue-next": "0.468.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "@vitejs/plugin-vue-jsx": "5.1.6",
    "autoprefixer": "10.4.20",
    "playwright": "1.62.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vue-tsc": "3.1.1",
    "wrangler": "4.115.0"
  }
}
