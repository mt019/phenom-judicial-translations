{
  "name": "phenom-judicial-translations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "data:local": "node scripts/export-local-data.mjs",
    "prebuild": "node scripts/prepare-build.mjs",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir .ssr && node scripts/render-static.mjs && node scripts/write-deployment-manifest.mjs && node scripts/validate-build.mjs",
    "dev": "node scripts/prepare-build.mjs && vite",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "dependencies": {
    "@phenomcanvas/ui": "https://github.com/mt019/phenom-ui/archive/refs/tags/v0.1.16.tar.gz",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "vite": "5.4.14",
    "wrangler": "4.115.0"
  }
}
